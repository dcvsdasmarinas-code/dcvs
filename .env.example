# ────────────────────────────────────────────────
# DCVS Environment Configuration — .env.example
# Copy this file to ".env" and fill in your REAL values.
# Never commit the .env file itself.
# ────────────────────────────────────────────────

# Database connection
DB_HOST=127.0.0.1
DB_NAME=dcvs
DB_USER=root
DB_PASS=

# Set to true to send via SMTP (false = PHP mail())
DCVS_SMTP_ENABLED=true

# Keep disabled until DCVS approves all 75 PSGC-to-database barangay mappings.
DCVS_REPORT_PIN_FEATURE_ENABLED=0
DCVS_BARANGAY_RESPONSE_ENABLED=0
# Targets are elapsed calendar hours, not a working-hours schedule.
DCVS_RESPONSE_TARGET_HOURS=24
DCVS_PROGRESS_TARGET_HOURS=48
DCVS_TURNOVER_TARGET_HOURS=24
# Optional MapTiler public browser key for the satellite basemap.
# The default street basemap uses CARTO Voyager with OpenStreetMap data.
DCVS_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY

# ── Recommended for production: Brevo (Sendinblue) SMTP ──
# Free tier: 300 emails/day. Works well with PHPMailer over SMTP.
DCVS_SMTP_HOST=smtp-relay.brevo.com
DCVS_SMTP_PORT=587
DCVS_SMTP_SECURE=tls
DCVS_SMTP_USER=YOUR_BREVO_SMTP_LOGIN
DCVS_SMTP_PASS=YOUR_BREVO_SMTP_KEY

# ── Alternative: Gmail SMTP (dev only) ──
# DCVS_SMTP_HOST=smtp.gmail.com
# DCVS_SMTP_PORT=587
# DCVS_SMTP_SECURE=tls
# DCVS_SMTP_USER=your@gmail.com
# DCVS_SMTP_PASS=your_gmail_app_password

# ── Sender Info ──
DCVS_MAIL_FROM=dcvs@example.com
DCVS_MAIL_FROM_NAME=DCVS Dasmarinas

# ── DCVS Branding ──
# DCVS_LOGO_URL=uploads/site/logo.png
# DCVS_PORTAL_URL=http://localhost/dcvs

# ── IPROG SMS ──
IPROGSMS_API_URL=https://www.iprogsms.com/api/v1/sms_messages
IPROGSMS_API_KEY=YOUR_IPROGSMS_API_KEY
# Optional approved sender name from IPROG SMS.
IPROGSMS_SENDER_NAME=

# ── Facebook Page announcements (server-side only) ──
# Keep disabled until the test Page ID and Page access token are configured.
APP_ENV=development
FB_ENABLED=false
FB_PAGE_ID=YOUR_TEST_PAGE_ID
FB_PAGE_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN
FB_GRAPH_VERSION=v26.0
# Non-production posting is blocked unless both Page IDs match exactly.
FB_TEST_PAGE_ID=YOUR_TEST_PAGE_ID