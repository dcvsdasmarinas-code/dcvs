# ────────────────────────────────────────────────
# DCVS Environment Configuration — .env.example
# Copy this file to ".env" and fill in your REAL values.
# Never commit the .env file itself.
# ────────────────────────────────────────────────

# Set to true to send via SMTP (false = PHP mail())
DCVS_SMTP_ENABLED=true

# ── Recommended for production: Brevo (Sendinblue) SMTP ──
# Free tier: 300 emails/day. Works well with PHPMailer over SMTP.
DCVS_SMTP_HOST=smtp-relay.brevo.com
DCVS_SMTP_PORT=587
DCVS_SMTP_SECURE=tls
DCVS_SMTP_USER=YOUR_BREVO_SMTP_LOGIN
DCVS_SMTP_PASS=YOUR_BREVO_SMTP_KEY

# ── Alternative: Gmail SMTP (dev only) ──
# DCVS_SMTP_HOST=smtp.gmail.com
# DCVS_SMTP_PORT=587
# DCVS_SMTP_SECURE=tls
# DCVS_SMTP_USER=your@gmail.com
# DCVS_SMTP_PASS=your_gmail_app_password

# ── Sender Info ──
DCVS_MAIL_FROM=dcvs@example.com
DCVS_MAIL_FROM_NAME=DCVS Dasmarinas

# ── DCVS Branding ──
# DCVS_LOGO_URL=uploads/site/logo.png
# DCVS_PORTAL_URL=http://localhost/dcvs