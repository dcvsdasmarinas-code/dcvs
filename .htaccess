# Report editing and client database compatibility routes.
RewriteRule ^edit-report\.php$ api/shared/edit-report.php [END]
RewriteRule ^client-database-handler\.php$ api/staff/client-database-handler.php [END]

# Keep uploaded case evidence available only through the permission-checked PHP endpoint.
RewriteRule ^uploads/report-evidence/ - [F,END]