# Public information, notifications, and report-management compatibility routes.
RewriteRule ^contact\.php$ pages/shared/contact.php [END]
RewriteRule ^faq\.php$ pages/shared/faq.php [END]
RewriteRule ^landing-page\.php$ pages/shared/landing-page.php [END]
