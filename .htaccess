# Block direct web access to sensitive files
<FilesMatch "^(\.env|\.env\.example|\.gitignore|env\.php|db\.php|email_config\.php)$">
    Require all denied
</FilesMatch>

# Admin compatibility routes.
RewriteEngine On
RewriteRule ^admin-archive\.php$ pages/admin/admin-archive.php [END]
RewriteRule ^dashboard-admin\.php$ pages/admin/dashboard-admin.php [END]
RewriteRule ^login-admin\.php$ pages/admin/login-admin.php [END]
RewriteRule ^role-management\.php$ pages/admin/role-management.php [END]
RewriteRule ^analytics-export\.php$ api/admin/analytics-export.php [END]
RewriteRule ^logout-admin\.php$ api/admin/logout-admin.php [END]
RewriteRule ^update-admin-password\.php$ api/admin/update-admin-password.php [END]
RewriteRule ^update-admin-profile\.php$ api/admin/update-admin-profile.php [END]

# Adoption compatibility routes.
RewriteRule ^adoption\.php$ pages/shared/adoption.php [END]
RewriteRule ^adoption-two\.php$ pages/shared/adoption-two.php [END]
RewriteRule ^adoption-document\.php$ pages/staff/adoption-document.php [END]
RewriteRule ^adoption-pool\.php$ pages/staff/adoption-pool.php [END]
RewriteRule ^adoption-workflow-handler\.php$ api/shared/adoption-workflow-handler.php [END]
RewriteRule ^adopt-process\.php$ api/shared/adopt-process.php [END]
RewriteRule ^resident-adoption-applications\.php$ pages/resident/resident-adoption-applications.php [END]
RewriteRule ^add-pet\.php$ api/resident/add-pet.php [END]
RewriteRule ^resident-add-pet\.php$ api/resident/resident-add-pet.php [END]
RewriteRule ^promote-pet-handler\.php$ api/staff/promote-pet-handler.php [END]
RewriteRule ^petlist\.php$ pages/shared/petlist.php [END]
RewriteRule ^pet-profile\.php$ pages/shared/pet-profile.php [END]

# Appointment compatibility routes.
RewriteRule ^appointment-availability\.php$ api/shared/appointment-availability.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^appointment-waitlist\.php$ api/shared/appointment-waitlist.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^appointment-waitlist-action\.php$ api/shared/appointment-waitlist-action.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^approve-appointment\.php$ api/staff/approve-appointment.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^archive-appointment\.php$ api/staff/archive-appointment.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^edit-appointment\.php$ api/staff/edit-appointment.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^reject-appointment\.php$ api/staff/reject-appointment.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^request-appointment\.php$ api/resident/request-appointment.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^resident-request-appointment\.php$ api/resident/resident-request-appointment.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^staff-add-appointment\.php$ api/staff/staff-add-appointment.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^staff-archive-appointment\.php$ api/staff/staff-archive-appointment.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^staff-create-appointment\.php$ api/staff/staff-create-appointment.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^staff-get-appointment-request\.php$ api/staff/staff-get-appointment-request.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
RewriteRule ^update-appointment-status\.php$ api/staff/update-appointment-status.php [END,E=DCVS_APPOINTMENT_ROUTE:1]
Header always set X-DCVS-Appointment-Route "rewritten" env=DCVS_APPOINTMENT_ROUTE
Header always set X-DCVS-Appointment-Route "rewritten" env=REDIRECT_DCVS_APPOINTMENT_ROUTE