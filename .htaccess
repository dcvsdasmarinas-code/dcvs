# Block direct web access to sensitive files
<FilesMatch "^(\.env|\.env\.example|\.gitignore|env\.php|db\.php|email_config\.php)$">
    Require all denied
</FilesMatch>

# Admin compatibility routes.
RewriteEngine On
RewriteRule ^admin-archive\.php$ pages/admin/admin-archive.php [END]
RewriteRule ^dashboard-admin\.php$ pages/admin/dashboard-admin.php [END]
RewriteRule ^login-admin\.php$ pages/admin/login-admin.php [END]
RewriteRule ^role-management\.php$ pages/admin/role-management.php [END]
RewriteRule ^analytics-export\.php$ api/admin/analytics-export.php [END]
RewriteRule ^logout-admin\.php$ api/admin/logout-admin.php [END]
RewriteRule ^update-admin-password\.php$ api/admin/update-admin-password.php [END]
RewriteRule ^update-admin-profile\.php$ api/admin/update-admin-profile.php [END]

# Adoption compatibility routes.
RewriteRule ^adoption\.php$ pages/shared/adoption.php [END]
RewriteRule ^adoption-two\.php$ pages/shared/adoption-two.php [END]
RewriteRule ^adoption-document\.php$ pages/staff/adoption-document.php [END]
RewriteRule ^adoption-pool\.php$ pages/staff/adoption-pool.php [END]
RewriteRule ^adoption-workflow-handler\.php$ api/shared/adoption-workflow-handler.php [END]
RewriteRule ^adopt-process\.php$ api/shared/adopt-process.php [END]
RewriteRule ^resident-adoption-applications\.php$ pages/resident/resident-adoption-applications.php [END]
RewriteRule ^add-pet\.php$ api/resident/add-pet.php [END]
RewriteRule ^resident-add-pet\.php$ api/resident/resident-add-pet.php [END]
RewriteRule ^promote-pet-handler\.php$ api/staff/promote-pet-handler.php [END]
RewriteRule ^petlist\.php$ pages/shared/petlist.php [END]
RewriteRule ^pet-profile\.php$ pages/shared/pet-profile.php [END]

# Appointment compatibility routes.
RewriteRule ^appointment-availability\.php$ api/shared/appointment-availability.php [END]
RewriteRule ^appointment-waitlist\.php$ api/shared/appointment-waitlist.php [END]
RewriteRule ^appointment-waitlist-action\.php$ api/shared/appointment-waitlist-action.php [END]
RewriteRule ^approve-appointment\.php$ api/staff/approve-appointment.php [END]
RewriteRule ^archive-appointment\.php$ api/staff/archive-appointment.php [END]
RewriteRule ^edit-appointment\.php$ api/staff/edit-appointment.php [END]
RewriteRule ^reject-appointment\.php$ api/staff/reject-appointment.php [END]
RewriteRule ^request-appointment\.php$ api/resident/request-appointment.php [END]
RewriteRule ^resident-request-appointment\.php$ api/resident/resident-request-appointment.php [END]
RewriteRule ^staff-add-appointment\.php$ api/staff/staff-add-appointment.php [END]
RewriteRule ^staff-archive-appointment\.php$ api/staff/staff-archive-appointment.php [END]
RewriteRule ^staff-create-appointment\.php$ api/staff/staff-create-appointment.php [END]
RewriteRule ^staff-get-appointment-request\.php$ api/staff/staff-get-appointment-request.php [END]
RewriteRule ^update-appointment-status\.php$ api/staff/update-appointment-status.php [END]

# Archive compatibility routes.
RewriteRule ^archive\.php$ pages/shared/archive.php [END]
RewriteRule ^barangay-archive\.php$ pages/barangay/barangay-archive.php [END]
RewriteRule ^staff-archive\.php$ pages/staff/staff-archive.php [END]
RewriteRule ^archive-pet\.php$ api/shared/archive-pet.php [END]
RewriteRule ^archive-report\.php$ api/shared/archive-report.php [END]
RewriteRule ^restore-report\.php$ api/shared/restore-report.php [END]

# Availability compatibility routes.
RewriteRule ^availability\.php$ pages/staff/availability.php [END]
RewriteRule ^availability-save\.php$ api/staff/availability-save.php [END]

# Dashboard compatibility routes.
RewriteRule ^dashboard-barangay\.php$ pages/barangay/dashboard-barangay.php [END]
RewriteRule ^dashboard-barangay-geo\.php$ pages/barangay/dashboard-barangay-geo.php [END]
RewriteRule ^dashboard-resident\.php$ pages/resident/dashboard-resident.php [END]
RewriteRule ^dashboard-staff\.php$ pages/staff/dashboard-staff.php [END]
RewriteRule ^dashboard-staff-geo\.php$ pages/staff/dashboard-staff-geo.php [END]

# Login and logout compatibility routes.
RewriteRule ^login\.php$ pages/shared/login.php [END]
RewriteRule ^login-barangay\.php$ pages/barangay/login-barangay.php [END]
RewriteRule ^login-staff\.php$ pages/staff/login-staff.php [END]
RewriteRule ^logout\.php$ api/shared/logout.php [END]
RewriteRule ^logout-barangay\.php$ api/barangay/logout-barangay.php [END]
RewriteRule ^logout-staff\.php$ api/staff/logout-staff.php [END]

# Staff compatibility routes.
RewriteRule ^register-staff\.php$ pages/staff/register-staff.php [END]
RewriteRule ^staff-announcements-handler\.php$ pages/staff/staff-announcements.php [END]
RewriteRule ^staff-announcements\.php$ api/staff/staff-announcements-handler.php [END]
RewriteRule ^staff-communication\.php$ pages/staff/staff-communication.php [END]
RewriteRule ^staff-filter-kpi\.php$ api/staff/staff-filter-kpi.php [END]
RewriteRule ^staff-get-history\.php$ api/staff/staff-get-owner-profile.php [END]
RewriteRule ^staff-get-owner-profile\.php$ api/staff/staff-get-history.php [END]
RewriteRule ^staff-pets-handler\.php$ api/staff/staff-pets-handler.php [END]
RewriteRule ^staff-pets\.php$ pages/staff/staff-pets.php [END]
RewriteRule ^staff-waitlist\.php$ pages/staff/staff-waitlist.php [END]
RewriteRule ^update-staff-password\.php$ api/staff/update-staff-password.php [END]
RewriteRule ^update-staff-profile\.php$ api/staff/update-staff-profile.php [END]