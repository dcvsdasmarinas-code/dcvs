              <?php if (count($announcements) === 0): ?>
                <p class="u-text-style-h5" style="max-width:40ch">No public service updates yet. Check back soon for kapon caravans, anti-rabies boosters, and welfare actions across Dasmariñas.</p>
              <?php else: foreach ($announcements as $ann):
                $cat = ($ann['category'] === 'advisory') ? 'Advisory' : 'Announcement';
                $ph = !empty($ann['photo_url']) ? htmlspecialchars($ann['photo_url']) : '';
                $d = date('M d, Y', strtotime($ann['created_at']));
                $link = ($ann['link_url'] !== '' && $ann['link_url'] !== null) ? $ann['link_url'] : '#';
                $hrefTop = ($link === '#' && $ph === '') ? '#' : ($ph !== '' ? '#' : $link);
              ?>
              <article class="hero_work_item" data-filter-name="<?php echo $ann['category']; ?>">
                <a class="e-ann-card" href="<?php echo htmlspecialchars($link); ?>" target="<?php echo ($link === '#' ? '_self' : '_blank'); ?>" rel="noopener">
                  <?php if ($ph !== ''): ?>
                  <div class="thumb"><img src="<?php echo $ph; ?>" alt="<?php echo htmlspecialchars($ann['title']); ?>" loading="lazy"></div>
                  <?php endif; ?>
                  <div class="body">
                    <div class="e-ann-meta"><span class="e-ann-tag"><?php echo $cat; ?></span><span><?php echo $d; ?></span></div>
                    <h2 class="e-ann-title"><?php echo htmlspecialchars($ann['title']); ?></h2>
                    <p class="e-ann-content"><?php echo htmlspecialchars($ann['content']); ?></p>
                    <?php if ($link !== '#'): ?><span class="e-ann-link">Learn more &rarr;</span><?php endif; ?>
                  </div>
                </a>
              </article>
              <?php endforeach; endif; ?>
            </div>
