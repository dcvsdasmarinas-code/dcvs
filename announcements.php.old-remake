<?php
require_once 'db.php';

$announcements = [];
$aq = $conn->query("SELECT * FROM announcements WHERE status = 'published' AND is_active = 1 ORDER BY created_at DESC");
if ($aq) {
    while ($row = $aq->fetch_assoc()) $announcements[] = $row;
}
