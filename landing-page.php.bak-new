.highlight-pill {
  display: inline-flex;
  margin: 0 auto;
  padding: 0.45rem 1.2rem;
  border-radius: 999px;
  background: #f3f8ff;
  color: #045e1f;
  letter-spacing: 0.1em;
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
}

.case-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1.8rem;
}

.case-card {
  position: relative;
  border-radius: 15px;
  overflow: hidden;
  min-height: 500px;
  min-width: 200px;
  display: flex;
  align-items: flex-end;
  background: var(--ink);
  box-shadow: 0 32px 60px rgba(20, 27, 47, 0.25);
  color: var(--white);
}

.case-card::before,
.case-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: opacity 0.6s var(--transition);
}

.case-card::before {
  background-image: var(--case-default, none);
  opacity: 1;
}

.case-card::after {
  background-image: var(--case-hover, none);
  opacity: 0;
  transform: scale(1.05);
}

.case-card.active::after,
.case-card:hover::after,
.case-card:focus-within::after {
  opacity: 1;
  transform: scale(1);
}

.case-card::after,
.case-card::before {
  filter: saturate(1.1);
}

.case-content {
  position: relative;
  z-index: 1;
  padding: 2.4rem 2.2rem;
  background: linear-gradient(180deg, rgba(12, 18, 32, 0), rgba(12, 18, 32, 0.78));
  display: grid;
  gap: 0.9rem;
}

.case-content h3 {
  margin: 0;
  font-size: 1.5rem;
}

.case-content p {
  margin: 0;
  color: rgba(255, 255, 255, 0.85);
}

.case-link {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  padding: 0.55rem 1.4rem;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.18);
  color: var(--white);
  font-weight: 600;
  transition: transform 0.3s var(--transition), background 0.3s var(--transition);
}

.case-link:hover,
.case-link:focus-visible {
  transform: translateY(-2px);
  background: rgba(255, 255, 255, 0.32);
}


.announcements {
  padding: 6rem 0 6.5rem;
   background: white
}

.announcements-shell {
  display: block;
}

.announcement-layout {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  gap: 1.2rem;
  align-items: stretch;
}

.announcement-lede {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 2.2rem;
  padding-right: 1rem;
}

.announcement-lede h2 {
  margin: 0;
  font-size: clamp(2.6rem, 4.6vw, 3.4rem);
  line-height: 0.95;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--primary);
}

.announcement-lede p {
  margin: 0;
  color: var(--accent-blue);
  max-width: 26ch;
}

.announcement-meta {
  display: inline-block;
  font-size: 0.75rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  font-weight: 700;
  color: var(--primary);
}


.announcement-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 2.2rem;
}

.announcement-card {
  position: relative;
  border-radius: 0;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  min-height: 320px;
  display: flex;
  align-items: flex-end;
  color: var(--white);
  box-shadow: 0 28px 60px rgba(20, 27, 47, 0.25);
  transition: transform 0.35s var(--transition), box-shadow 0.35s var(--transition);
}

.announcement-card::before,
.announcement-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: opacity 0.6s var(--transition), transform 0.6s var(--transition);
  filter: saturate(1.05);
}

.announcement-card::before {
  background-image: var(--announcement-default, none);
  opacity: 1;
}

.announcement-card::after {
  background-image: var(--announcement-hover, none);
  opacity: 0;
  transform: scale(1.05);
}

.announcement-card.active::after,
.announcement-card:hover::after,
.announcement-card:focus-within::after {
  opacity: 1;
  transform: scale(1);
}

.announcement-card:hover,
.announcement-card:focus-within {
  transform: translateY(-12px);
  box-shadow: 0 40px 90px rgba(20, 27, 47, 0.38);
}

.announcement-content {
  position: relative;
  z-index: 1;
  padding: 2.8rem 2.4rem;
  width: 100%;
  display: grid;
  gap: 1rem;
  background: linear-gradient(195deg, rgba(11, 22, 35, 0), rgba(11, 22, 35, 0.88));
  /* Hide content by default, reveal on hover */
  opacity: 0;
  transform: translateY(20px);
  transition: opacity 0.4s var(--transition), transform 0.4s var(--transition);
}

.announcement-card:hover .announcement-content,
.announcement-card:focus-within .announcement-content {
  opacity: 1;
  transform: translateY(0);
}

.announcement-date {
  font-weight: 700;
  letter-spacing: 0.08em;
  font-size: 0.78rem;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.78);
}

.announcement-card h3 {
  margin: 0;
  font-size: 1.55rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.announcement-card p {
  margin: 0;
  color: rgba(255, 255, 255, 0.9);
  font-size: 0.98rem;
}

.announcement-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.55rem 1.6rem;
  border-radius: 999px;
  border: 1.4px solid rgba(255, 255, 255, 0.6);
  color: var(--white);
  font-weight: 600;
  font-size: 0.9rem;
  transition: background 0.3s var(--transition), border 0.3s var(--transition),
    transform 0.3s var(--transition), letter-spacing 0.3s var(--transition);
}

.announcement-cta:hover,
.announcement-cta:focus-visible {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.6);
  transform: translateY(-3px);
  letter-spacing: 0.08em;
}

/* Remove old case-card CSS */
.highlight {
  padding: 6rem 0;
  background: #ffffff;
  display: grid;
  gap: 3.2rem;
}

.highlight-intro {
  text-align: center;
  width: min(680px, 80vw);
  display: grid;
  gap: 1rem;
  margin: 0 auto;
}

.highlight-intro h2 {
  margin: 0;
  font-size: clamp(2.2rem, 4vw, 2.8rem);
  font-family: 'Montserrat', sans-serif;
  font-weight: 800;
  color: #045e1f;
  line-height: 1.15;
}

.highlight-intro p {
  color: #212121;
  margin: 0;
  font-size: 1.125rem;
  font-family: 'Open Sans', sans-serif;
  line-height: 1.7;
}

.highlight-pill {
  display: inline-flex;
  margin: 0 auto;
  padding: 0.45rem 1.2rem;
  border-radius: 999px;
  background: #f3f8ff;
  color: #045e1f;
  letter-spacing: 0.1em;
  font-size: 0.78rem;
  font-weight: 600;
  text-transform: uppercase;
}

/* Responsive layout for mobile */
@media (max-width: 768px) {
  .announcement-grid {
    grid-template-columns: 1fr;
  }
  
}
/* Get Started Section - enhanced visibility and highlighting */
.get-started-section {
  padding: 4rem 3rem;
  background: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.get-started-container {
  background: white;
  width: 100%;
  padding: 4rem 7.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 3rem;
  position: relative;
  z-index: 1;
  border-radius: 12px;
  box-shadow: 0 10px 40px rgba(160, 2, 2, 0.08);
  border: 2px solid #045E1FD9;
}

.get-started-content {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  flex: 0 0 auto;
}

.get-started-title {
  font-size: 2.8rem;
  font-weight: 900;
  background:#045E1FD9;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin: 0;
  letter-spacing: -0.05em;
  line-height: 1.1;
  text-transform: uppercase;
}

.get-started-right {
  display: flex;
  flex-direction: column;
  gap: 1.2rem;
  align-items: flex-end;
  flex: 1;
}

.get-started-description {
  font-size: 1.1rem;
  color: #2c3e50;
  margin: 0;
  text-align: right;
  font-weight: 500;
}

.get-started-buttons {
  display: flex;
  gap: 1rem;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.cta-button {
  padding: 0.75rem 2rem;
  border: none;
  border-radius: 6px;
  font-weight: 700;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
  letter-spacing: 0.01em;
  text-transform: uppercase;
}

.primary-button {
  background: #045E1FD9;
  color: white;
  box-shadow: 0 4px 15px rgba(3, 136, 58, 0.4);
}

.primary-button:hover {
  background: #045E1FD9;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px #045E1FD9;
}

.secondary-button {
  background: transparent;
  color: #045E1FD9;
  border: 2px solid #045E1FD9;
}

.secondary-button:hover {
  background: #045E1FD9;
  color: white;
  transform: translateY(-2px);
}

@media (max-width: 768px) {
  .get-started-container {
    flex-direction: column;
    text-align: center;
    gap: 2rem;
    padding: 2.5rem 2rem;
  }

  .get-started-title {
    font-size: 2rem;
  }

  .get-started-right {
    align-items: center;
    width: 100%;
  }

  .get-started-description {
    text-align: center;
  }

  .get-started-buttons {
    justify-content: center;
    width: 100%;
  }
}

/* Footer - Brand on left, multi-column links */
.site-footer {
  background: linear-gradient(180deg, #0b1a0f 30%, #045e1fd9 80%);
  color: #e8f1eb;
  padding: 4rem 3rem 2.5rem;
  margin-top: 0;
  border-top: 1px solid #0a3c14;
}

.footer-container {
  display: flex;
  gap: 4rem;
  max-width: 1400px;
  margin: 0 auto 3rem;
}

.footer-brand-column {
  flex: 0 0 280px;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.footer-brand {
  font-size: 1.4rem;
  font-weight: 700;
  color: #ffffff;
  margin: 0;
  display: flex;
  gap: 0.6rem;
  align-items: baseline;
}

.footer-brand-tag {
  font-size: 0.75rem;
  font-weight: 500;
  color: #b8d9bf;
  letter-spacing: 0.05em;
}

.footer-description {
  font-size: 0.9rem;
  color: #c5d9cc;
  line-height: 1.6;
  margin: 0;
}

.footer-socials {
  display: flex;
  gap: 0.7rem;
  margin-top: 0.5rem;
}

.social-link {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  font-size: 0.8rem;
}

.social-link:hover {
  background: #4ade80;
  color: #000;
  transform: translateY(-2px);
}

.footer-link-group {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3rem;
  flex: 1;
}

.footer-column {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.footer-section-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: #ffffff;
  margin: 0;
  line-height: 1.4;
}

.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
}

.footer-links a {
  color: #c5d9cc;
  text-decoration: none;
  font-size: 0.9rem;
  transition: color 0.3s ease;
  line-height: 1.5;
}

.footer-links a:hover {
  color: #4ade80;
}

/* Footer bottom with side-by-side layout */
.footer-bottom {
  border-top: 1px solid #0a3c14;
  padding-top: 2rem;
}

.footer-bottom-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  max-width: 1400px;
  margin: 0 auto;
}

.footer-bottom-socials {
  display: flex;
  gap: 0.6rem;
}

.social-link-small {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  font-size: 0.75rem;
}

.social-link-small:hover {
  background: #4ade80;
  color: #000;
  transform: translateY(-2px);
}

.footer-bottom p {
  color: #9db4a0;
  font-size: 0.85rem;
  margin: 0;
}

/* Responsive Design */
@media (max-width: 1024px) {
  .footer-link-group {
    grid-template-columns: repeat(2, 1fr);
