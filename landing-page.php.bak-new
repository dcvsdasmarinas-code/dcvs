            <?php
            $annCount = count($announcementItems);
            $annSlots = max(6, $annCount);
            for ($j = 0; $j < $annSlots; $j++):
              $ann = $announcementItems[$j] ?? null;
            ?>
            <article
              class="announcement-card"
              data-aos="fade-up"
              data-aos-delay="<?php echo ($j % 3) * 120; ?>"
              data-image-default="<?php echo $ann ? htmlspecialchars($ann['photo_url'] ?? '') : ''; ?>"
              data-image-hover=""
            >
              <div class="announcement-content">
                <span class="announcement-date"><?php echo $ann ? date('M d', strtotime($ann['created_at'])) : ''; ?></span>
                <h3><?php echo $ann ? htmlspecialchars($ann['title']) : ''; ?></h3>
                <p><?php echo $ann ? htmlspecialchars($ann['content']) : ''; ?></p>
                <?php if ($ann && !empty($ann['link_url'])): ?>
                <a class="announcement-cta" href="<?php echo htmlspecialchars($ann['link_url']); ?>">Learn more</a>
                <?php endif; ?>
              </div>
            </article>
            <?php endfor; ?>
            </div>
          </div>
        </div>
      </section>

