.reveal {
  opacity: 0;
  transform: translateY(40px);
  transition: opacity 0.9s var(--transition), transform 0.9s var(--transition);
}

.reveal.reveal-active {
  opacity: 1;
  transform: translateY(0);
}

.hero-step {
  opacity: 0;
  transform: translateY(24px);
}

.hero-loaded .hero-step {
  opacity: 1;
  transform: none;
  transition: opacity 0.7s var(--transition), transform 0.7s var(--transition);
}

.hero-loaded .step-1 {
  transition-delay: 0.1s;
}

.hero-loaded .step-2 {
  transition-delay: 0.25s;
}

.hero-loaded .step-3 {
  transition-delay: 0.4s;
}

.hero-loaded .step-4 {
  transition-delay: 0.55s;
}

.hero-loaded .step-5 {
  transition-delay: 0.7s;
}

@media (max-width: 1100px) {
  .navbar {
    border-radius: 24px;
  }

  .nav-links {
    position: fixed;
    inset: 90px 1.5rem auto 1.5rem;
    background: #ffffff;
    border-radius: 24px;
    padding: 1.8rem;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    box-shadow: 0 24px 60px rgba(18, 39, 84, 0.25);
    transform: translateY(-20px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--transition), transform 0.3s var(--transition);
    max-height: calc(100vh - 110px);
    overflow-y: auto;
  }

  .nav-links.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .nav-toggle {
    display: flex;
  }

  .hero-grid {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .hero-text {
    justify-items: center;
  }

  .hero-visual {
    order: -1;
  }

  .partner-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .achievements-body {
    grid-template-columns: 1fr;
  }

  .achievements-pip.secondary,
  .achievements-pip.tertiary {
    position: static;
    width: auto;
  }

  .achievements-hero {
    padding: 2.6rem;
  }

  .achievements-stats,
  .case-grid,
  .announcement-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: row;
    overflow: visible;
  }

  .announcement-layout {
    grid-template-columns: 1fr;
  }

  .announcement-lede {
    flex-direction: column;
    gap: 1.6rem;
    margin-bottom: 1.8rem;
  }

  .cta-panel {
    flex-direction: column;
