<?php
require_once 'db.php';

// Fetch published advisories (for Field Impact section)
$advisories = [];
$aq = $conn->query("SELECT * FROM announcements WHERE category = 'advisory' AND status = 'published' AND is_active = 1 ORDER BY created_at DESC");
if ($aq) {
    while ($row = $aq->fetch_assoc()) $advisories[] = $row;
}

// Fetch published announcements (for Public Service Updates section)
$announcementItems = [];
$anq = $conn->query("SELECT * FROM announcements WHERE category = 'announcement' AND status = 'published' AND is_active = 1 ORDER BY created_at DESC");
if ($anq) {
    while ($row = $anq->fetch_assoc()) $announcementItems[] = $row;
}
?>
